{
  "name": "ename-registry",
  "description": "Ename registry monorepo",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26.1",
    "npm": ">=12"
  },
  "workspaces": [
    "database",
    "backend"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "prettier --check . && npm run format --workspaces",
    "format:fix": "prettier --write . && npm run format:fix --workspaces",
    "test": "npm run test --workspaces",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
