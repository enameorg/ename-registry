{
  "name": "ename-registry-backend",
  "version": "0.1.0",
  "description": "Ename registry backend",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "NODE_ENV=test LOG_LEVEL=silent node --env-file-if-exists=.env --test --test-concurrency=1",
    "test:coverage": "NODE_ENV=test LOG_LEVEL=silent node --env-file-if-exists=.env --test --test-concurrency=1 --experimental-test-coverage",
    "openapi:generate": "node --env-file-if-exists=.env scripts/generate-openapi.ts",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.11",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
