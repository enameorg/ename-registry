{
  "name": "ename-registry-backend",
  "version": "0.1.0",
  "description": "Ename registry backend",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26.1",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env.development src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "node --env-file=.env.test --test --test-concurrency=1 --test-reporter=dot",
    "test:coverage": "node --env-file=.env.test --test --test-concurrency=1 --test-reporter=dot --experimental-test-coverage",
    "openapi:generate": "node --env-file=.env.development scripts/generate-openapi.ts",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.11",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1"
  }
}
