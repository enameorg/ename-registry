# Local development environment, loaded by `npm run dev` and
# `npm run openapi:generate`. Copy to .env.development. A variable exported in
# the shell outranks this file. In production no file is loaded: the deployment
# sets the variables.

# HTTP port. In production, Scaleway Serverless Containers inject it.
PORT=3000

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# The local PostgreSQL provisioned by the sibling `database/` package
# (cf. ../database/compose.yml).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ename_dev

# Connections one process may hold at once (pg.Pool max). Local size here; in
# production, set it to the container's concurrency per instance, keeping
# size × max instances under the Serverless SQL connection limit.
DATABASE_POOL_SIZE=10
