{
  "openapi": "3.1.0",
  "info": {
    "title": "Ename Registry API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unhealthy"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "RegisterSubjectResponse": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-27T14:32:11.123Z"
          },
          "subject": {
            "$ref": "#/components/schemas/Subject"
          },
          "ename": {
            "$ref": "#/components/schemas/Ename"
          }
        },
        "required": [
          "createdAt",
          "subject",
          "ename"
        ]
      },
      "Subject": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "example": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e1a"
          },
          "kind": {
            "type": "string",
            "enum": [
              "person"
            ],
            "example": "person"
          }
        },
        "required": [
          "id",
          "kind"
        ]
      },
      "Ename": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "example": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e10"
          },
          "namePart": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[a-z]+(-[a-z]+)*$",
            "example": "jean-dupont"
          },
          "numberPart": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999999,
            "example": 1
          }
        },
        "required": [
          "id",
          "namePart",
          "numberPart"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Validation failed"
          },
          "status": {
            "type": "integer",
            "example": 422
          },
          "detail": {
            "type": "string",
            "example": "1 validation error."
          },
          "requestId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "example": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e2b"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            },
            "example": [
              {
                "path": [
                  "ename",
                  "namePart"
                ],
                "message": "must be lowercase letters separated by single hyphens (no leading, trailing or consecutive hyphens)"
              }
            ]
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "requestId"
        ]
      },
      "RegisterSubjectRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "example": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e0f"
          },
          "signature": {
            "$ref": "#/components/schemas/Signature"
          },
          "subject": {
            "$ref": "#/components/schemas/SubjectInput"
          },
          "ename": {
            "$ref": "#/components/schemas/EnameInput"
          }
        },
        "required": [
          "idempotencyKey",
          "signature",
          "subject",
          "ename"
        ],
        "additionalProperties": false
      },
      "Signature": {
        "type": "object",
        "properties": {
          "keyId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "value": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "keyId",
          "value"
        ],
        "additionalProperties": false,
        "example": {
          "keyId": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e2c",
          "value": "conZ143ZmXnjabp53VoZ9ng3_bcW8UbWTrqdBjyt_-dXQhqQVkK7BmOy2gzHz75clmlBDpEn3SDurH5taRqn1w"
        }
      },
      "SubjectInput": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "person"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false,
        "example": {
          "kind": "person"
        }
      },
      "EnameInput": {
        "type": "object",
        "properties": {
          "namePart": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[a-z]+(-[a-z]+)*$"
          }
        },
        "required": [
          "namePart"
        ],
        "additionalProperties": false,
        "example": {
          "namePart": "jean-dupont"
        }
      },
      "AddEnameToSubjectResponse": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-30T14:32:11.123Z"
          },
          "subject": {
            "$ref": "#/components/schemas/SubjectReference"
          },
          "ename": {
            "$ref": "#/components/schemas/Ename"
          }
        },
        "required": [
          "createdAt",
          "subject",
          "ename"
        ]
      },
      "SubjectReference": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "example": {
          "id": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e1a"
        }
      },
      "AddEnameToSubjectRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "example": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e0f"
          },
          "signature": {
            "$ref": "#/components/schemas/Signature"
          },
          "ename": {
            "$ref": "#/components/schemas/EnameInput"
          }
        },
        "required": [
          "idempotencyKey",
          "signature",
          "ename"
        ],
        "additionalProperties": false
      },
      "AccreditPlatformResponse": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-30T09:12:44.512Z"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "key": {
            "$ref": "#/components/schemas/Key"
          }
        },
        "required": [
          "createdAt",
          "platform",
          "key"
        ]
      },
      "Platform": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "example": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e3b"
          },
          "legalName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "example": "1PLACE"
          },
          "jurisdiction": {
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$",
            "example": "FR"
          },
          "registrationAuthorityCode": {
            "type": "string",
            "pattern": "^RA[0-9]{6}$",
            "example": "RA000189"
          },
          "registrationIdentifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "951595875"
          }
        },
        "required": [
          "id",
          "legalName",
          "jurisdiction",
          "registrationAuthorityCode",
          "registrationIdentifier"
        ]
      },
      "Key": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "example": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e4c"
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "ecdsa-p256-sha256"
            ],
            "example": "ecdsa-p256-sha256"
          },
          "value": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "example": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEHrnigtJMJ_tcAdRsy4ZMy4p5R_-SVhFWZymWEFBCuFSznCy-sPtD8JD5pToqEI6AZUc0PLhuJTarVCAh0M5-yg"
          }
        },
        "required": [
          "id",
          "algorithm",
          "value"
        ]
      },
      "AccreditPlatformRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "example": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e0f"
          },
          "signature": {
            "$ref": "#/components/schemas/Signature"
          },
          "platform": {
            "$ref": "#/components/schemas/PlatformInput"
          },
          "key": {
            "$ref": "#/components/schemas/KeyInput"
          }
        },
        "required": [
          "idempotencyKey",
          "signature",
          "platform",
          "key"
        ],
        "additionalProperties": false
      },
      "PlatformInput": {
        "type": "object",
        "properties": {
          "legalName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "jurisdiction": {
            "type": "string",
            "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
          },
          "registrationAuthorityCode": {
            "type": "string",
            "pattern": "^RA[0-9]{6}$"
          },
          "registrationIdentifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "legalName",
          "jurisdiction",
          "registrationAuthorityCode",
          "registrationIdentifier"
        ],
        "additionalProperties": false,
        "example": {
          "legalName": "1PLACE",
          "jurisdiction": "FR",
          "registrationAuthorityCode": "RA000189",
          "registrationIdentifier": "951595875"
        }
      },
      "KeyInput": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string",
            "enum": [
              "ecdsa-p256-sha256"
            ]
          },
          "value": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "algorithm",
          "value"
        ],
        "additionalProperties": false,
        "example": {
          "algorithm": "ecdsa-p256-sha256",
          "value": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEHrnigtJMJ_tcAdRsy4ZMy4p5R_-SVhFWZymWEFBCuFSznCy-sPtD8JD5pToqEI6AZUc0PLhuJTarVCAh0M5-yg"
        }
      },
      "AddPlatformKeyResponse": {
        "type": "object",
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-30T09:12:44.512Z"
          },
          "platform": {
            "$ref": "#/components/schemas/PlatformReference"
          },
          "key": {
            "$ref": "#/components/schemas/Key"
          }
        },
        "required": [
          "createdAt",
          "platform",
          "key"
        ]
      },
      "PlatformReference": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "example": {
          "id": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e3b"
        }
      },
      "AddPlatformKeyRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "example": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e0f"
          },
          "signature": {
            "$ref": "#/components/schemas/Signature"
          },
          "key": {
            "$ref": "#/components/schemas/KeyInput"
          }
        },
        "required": [
          "idempotencyKey",
          "signature",
          "key"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health check",
        "description": "Returns 200 with status \"ok\" when the service is healthy, 503 with status \"unhealthy\" otherwise.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service is unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/deep": {
      "get": {
        "summary": "Deep health check (database)",
        "description": "Returns 200 with status \"ok\" when the database answers a trivial query within a short bound, 503 with status \"unhealthy\" otherwise. Meant for monitoring and smoke tests, not for the container liveness probe.",
        "responses": {
          "200": {
            "description": "Service and its database are healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable or too slow",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/subjects": {
      "post": {
        "summary": "Register a new subject (with its first ename)",
        "description": "Atomically registers a new subject (of `kind = person` in v1) together with its first ename. A subject without at least one ename has no meaning in the registry — the two are created together. The body must be signed by a key of an accredited platform, which becomes the home platform of the subject. Emits one `subject.registered` event in the registry log. Idempotent via `idempotencyKey`: retrying with the same key returns the original result; reusing the same key for a different request, or under another signing key, returns `409 Conflict`.",
        "x-ename-operation": "subject.register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterSubjectRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subject and first ename registered (or idempotent replay of a prior success)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterSubjectResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request body could not be read properly",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Request signature could not be verified",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Request signer is not allowed to submit this request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Request conflicts with the current state or a prior use of its idempotency key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the size limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Request body media type is not supported",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Request body failed validation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable; retry after the Retry-After delay",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/subjects/{id}/enames": {
      "post": {
        "summary": "Add an ename to an existing subject",
        "description": "Adds one ename to an existing subject without replacing its previous enames. The body must be signed by a key of the home platform of the subject. Emits one `subject.ename-added` event in the registry log. A subject cannot hold two enames with the same `namePart`; reusing the same `namePart` for the same subject returns `409 Conflict`. Idempotent via `idempotencyKey`: retrying with the same key returns the original result; reusing the same key for a different request, or under another signing key, returns `409 Conflict`.",
        "x-ename-operation": "subject.add-ename",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "example": "01927e8f-9b2a-7c3d-8e4f-5a6b7c8d9e1a"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddEnameToSubjectRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ename added to subject (or idempotent replay of a prior success)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddEnameToSubjectResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request body could not be read properly",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Request signature could not be verified",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Request signer is not allowed to submit this request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Subject not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Request conflicts with the current state or a prior use of its idempotency key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds the size limit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Request body media type is not supported",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Path parameter or request body failed validation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
