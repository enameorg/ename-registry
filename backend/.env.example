# HTTP port. Scaleway injects this in production; the default is for local dev.
PORT=3000

# Runtime environment: development | production | test
NODE_ENV=development

# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# PostgreSQL connection strings. In production, Scaleway injects DATABASE_URL.
# Locally, both point at the Docker Compose Postgres container provisioned by
# the sibling `database/` package (cf. ../database/compose.yml). The two URLs
# are explicit so a misconfigured NODE_ENV cannot accidentally point the test
# runner at the dev database.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ename_dev
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ename_test
