# Test environment, loaded by `npm test` and `npm run test:coverage`. Copy to
# .env.test. A variable exported in the shell outranks this file; the
# test-database guard refuses any database whose name does not end in _test.

# Pino log level: silent keeps the test output readable.
LOG_LEVEL=silent

# The test database of the local cluster provisioned by the sibling `database/`
# package (cf. ../database/compose.yml).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ename_test

# The pool size the burst test in register-subject.test.ts was measured at; a
# smaller one weakens its assertion.
DATABASE_POOL_SIZE=10
