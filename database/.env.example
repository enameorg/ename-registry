# PostgreSQL connection strings used by the migration runner. In local dev both
# point at the Docker Compose Postgres container (cf. docker-compose.yml at the
# repo root). The two URLs are explicit so a misconfigured target cannot
# accidentally apply migrations to the wrong database.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ename_dev
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ename_test
